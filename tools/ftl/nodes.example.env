# ─── Test nodes for ftl-run.sh (copy to nodes.env, fill in, keep it out of git) ───
# FTL_NODE_IP: the node's public IPv4. The test checks that each protocol's exit IP equals it.
# FTL_NODES: one listed node entry per protocol (on-chain node address), comma-separated <protocol>:<address>.
FTL_NODE_IP=203.0.113.10
FTL_NODES=wireguard:<node-address>,amneziawg:<node-address>,openvpn:<node-address>,v2ray:<node-address>,xray:<node-address>,hysteria2:<node-address>
